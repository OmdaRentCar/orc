{
  "name": "rentcar-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backup": "bash scripts/backup.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "seed:demo": "tsx prisma/demo-seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
