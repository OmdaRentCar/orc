generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One subscribing rental agency. Every business table belongs to exactly one agency.
model Agency {
  id               Int               @id @default(autoincrement())
  slug             String            @unique // its address: {slug}.<platform domain>
  name             String
  customDomain     String?           @unique @map("custom_domain") // e.g. location-sfax.tn (higher plans)
  logoUrl          String?           @map("logo_url")
  primaryColor     String            @default("#e72526") @map("primary_color")
  // Subscription: trial -> active -> past_due (unpaid, still working for a grace period) -> suspended; cancelled = closed
  status           String            @default("active")
  plan             String            @default("business") // starter | pro | business (see src/lib/plans.ts)
  billingCycle     String            @default("monthly") @map("billing_cycle") // monthly | yearly
  trialEndsAt      DateTime?         @map("trial_ends_at")
  currentPeriodEnd DateTime?         @map("current_period_end") // paid until; null on an active agency = no expiry (granted by the platform)
  pastDueSince     DateTime?         @map("past_due_since")
  // Contact and marketplace profile
  ownerEmail       String?           @map("owner_email")
  phone            String?
  city             String?
  listed           Boolean           @default(true) // shown on the platform marketplace
  // Own domain, once its DNS records are verified
  pendingDomain    String?           @map("pending_domain")
  domainToken      String?           @map("domain_token")
  domainVerifiedAt DateTime?         @map("domain_verified_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  invoices         Invoice[]
  adminUsers       AdminUser[]
  cars             Car[]
  bookings         Booking[]
  notifications    Notification[]
  settings         BusinessSettings?
  blockedCustomers BlockedCustomer[]
  auditLogs        AuditLog[]
  inspections      Inspection[]
  fines            Fine[]
  expenses         Expense[]
  onlineContracts  OnlineContract[]

  @@map("agencies")
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  agencyId     Int        @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  username     String
  email        String
  passwordHash String     @map("password_hash")
  role         String     @default("staff") // owner | staff
  createdAt    DateTime   @default(now()) @map("created_at")
  auditLogs    AuditLog[]

  @@unique([agencyId, username])
  @@unique([agencyId, email])
  @@index([agencyId])
  @@map("admin_users")
}

model Car {
  id               Int       @id @default(autoincrement())
  agencyId         Int       @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  type             String
  year             Int
  price            Float
  image            String?
  images           String[]  @default([]) // extra gallery photos, shown on the car page
  available        Boolean   @default(true)
  seats            Int       @default(5)
  fuel             String    @default("Petrol")
  transmission     String    @default("Auto")
  description      String?
  features         String[]  @default([])
  plateNumber      String?   @map("plate_number")
  mileage          Int       @default(0) // current odometer, km
  insuranceExpiry  String?   @map("insurance_expiry") // YYYY-MM-DD
  vignetteExpiry   String?   @map("vignette_expiry")
  inspectionExpiry String?   @map("inspection_expiry") // visite technique
  nextServiceKm    Int?      @map("next_service_km")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  bookings         Booking[]
  fines            Fine[]
  expenses         Expense[]

  @@index([brand])
  @@index([type])
  @@index([agencyId])
  @@map("cars")
}

model Booking {
  id                 Int             @id @default(autoincrement())
  agencyId           Int             @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency             Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reference          String          @unique // shown to the customer, used on the status page
  carId              Int             @map("car_id")
  guestName          String          @map("guest_name")
  phone              String
  email              String?
  startDate          String          @map("start_date")
  endDate            String          @map("end_date")
  pickupTime         String          @default("10:00") @map("pickup_time")
  returnTime         String          @default("10:00") @map("return_time")
  deliveryType       String          @default("agency") @map("delivery_type") // agency | delivery
  deliveryAddress    String?         @map("delivery_address")
  // pending -> approved -> picked_up -> completed; or declined / cancelled
  status             String          @default("pending")
  documentImage      String?         @map("document_image")
  extras             Json            @default("[]")
  subtotal           Float           @default(0)
  discount           Float           @default(0)
  extrasTotal        Float           @default(0) @map("extras_total")
  deliveryFee        Float           @default(0) @map("delivery_fee")
  total              Float
  deposit            Float           @default(0)
  paymentStatus      String          @default("unpaid") @map("payment_status") // unpaid | deposit | paid
  amountPaid         Float           @default(0) @map("amount_paid")
  locale             String          @default("en") // language used for customer emails
  source             String          @default("online") // online | admin
  notes              String?
  // Driver details (checked against the minimum age / licence years, printed on the contract)
  birthDate          String?         @map("birth_date")
  licenseNumber      String?         @map("license_number")
  licenseIssueDate   String?         @map("license_issue_date")
  licenseExpiry      String?         @map("license_expiry")
  idNumber           String?         @map("id_number") // CIN or passport
  customerAddress    String?         @map("customer_address")
  // Charges added after the booking: extra km, fuel, late return, damage, fines
  extraCharges       Json            @default("[]") @map("extra_charges")
  extraChargesTotal  Float           @default(0) @map("extra_charges_total")
  pickupReminderSent Boolean         @default(false) @map("pickup_reminder_sent")
  returnReminderSent Boolean         @default(false) @map("return_reminder_sent")
  lateNotified       Boolean         @default(false) @map("late_notified")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  car                Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
  notifications      Notification[]
  inspections        Inspection[]
  fines              Fine[]
  onlineContract     OnlineContract?

  @@index([carId, status, startDate, endDate])
  @@index([createdAt])
  @@index([phone])
  @@index([agencyId])
  @@map("bookings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  agencyId  Int      @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  bookingId Int?     @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([read])
  @@index([agencyId])
  @@map("notifications")
}

// Single row (id = 1) holding pricing and business options editable from the admin Settings page
model BusinessSettings {
  agencyId  Int      @id @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model BlockedCustomer {
  id        Int      @id @default(autoincrement())
  agencyId  Int      @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  phone     String // digits only, see normalizePhone()
  name      String?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([agencyId, phone])
  @@index([agencyId])
  @@map("blocked_customers")
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  agencyId  Int        @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  adminId   Int?       @map("admin_id")
  username  String
  action    String
  entity    String
  entityId  Int?       @map("entity_id")
  details   String?
  createdAt DateTime   @default(now()) @map("created_at")
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([agencyId])
  @@map("audit_logs")
}

// Car handover: one at pick-up ("checkout") and one at return ("checkin")
model Inspection {
  id         Int      @id @default(autoincrement())
  agencyId   Int      @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId  Int      @map("booking_id")
  type       String // checkout | checkin
  mileage    Int
  fuelLevel  Int      @map("fuel_level") // eighths of a tank, 0-8
  damages    Json     @default("[]") // [{ x, y, note }] on the car outline, 0-100
  photos     String[] @default([]) // private Cloudinary URLs
  signature  String? // private Cloudinary URL of the customer's signature
  signerName String   @map("signer_name")
  notes      String?
  staffName  String   @map("staff_name")
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([agencyId])
  @@map("inspections")
}

model Fine {
  id          Int      @id @default(autoincrement())
  agencyId    Int      @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId       Int      @map("car_id")
  bookingId   Int?     @map("booking_id")
  date        String // YYYY-MM-DD of the offence
  time        String // HH:MM
  amount      Float
  description String?
  status      String   @default("open") // open | charged | paid
  createdAt   DateTime @default(now()) @map("created_at")
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([carId, date])
  @@index([agencyId])
  @@map("fines")
}

model Expense {
  id        Int      @id @default(autoincrement())
  agencyId  Int      @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  carId     Int      @map("car_id")
  date      String // YYYY-MM-DD
  category  String // repair | service | tyres | insurance | documents | cleaning | other
  amount    Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, date])
  @@index([agencyId])
  @@map("expenses")
}

// Remembers which automatic alerts were already sent, so each one goes out once
model AlertLog {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("alert_logs")
}

// Contract signed remotely by the customer: link by email, one-time code, drawn signature,
// then a frozen PDF whose SHA-256 fingerprint proves it was never changed afterwards
model OnlineContract {
  id               Int       @id @default(autoincrement())
  agencyId         Int       @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId        Int       @unique @map("booking_id")
  tokenHash        String    @unique @map("token_hash") // SHA-256 of the link token; the token itself is never stored
  expiresAt        DateTime  @map("expires_at")
  sentAt           DateTime  @default(now()) @map("sent_at")
  sentBy           String    @map("sent_by") // staff member who issued it on behalf of the agency
  otpHash          String?   @map("otp_hash")
  otpExpiresAt     DateTime? @map("otp_expires_at")
  otpAttempts      Int       @default(0) @map("otp_attempts")
  otpSentCount     Int       @default(0) @map("otp_sent_count")
  otpLastSentAt    DateTime? @map("otp_last_sent_at")
  viewedAt         DateTime? @map("viewed_at")
  signedAt         DateTime? @map("signed_at")
  signerName       String?   @map("signer_name")
  signerIp         String?   @map("signer_ip")
  signerUserAgent  String?   @map("signer_user_agent")
  signature        String? // private Cloudinary image
  pdfUrl           String?   @map("pdf_url") // private Cloudinary copy of the signed PDF, never regenerated
  documentHash     String?   @map("document_hash") // SHA-256 of the signed PDF
  verificationCode String?   @unique @map("verification_code")
  revokedAt        DateTime? @map("revoked_at")
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("online_contracts")
}

// What an agency pays the platform: one invoice per subscription period
model Invoice {
  id          Int       @id @default(autoincrement())
  agencyId    Int       @default(dbgenerated("(current_setting('app.agency_id'))::integer")) @map("agency_id")
  number      String?   @unique // given when paid, e.g. INV-2026-00012
  plan        String
  cycle       String // monthly | yearly
  months      Int
  amount      Float // DT, tax included
  status      String    @default("pending") // pending | paid | failed | cancelled
  provider    String // konnect | flouci | manual | transfer | cash
  providerRef String?   @unique @map("provider_ref")
  payUrl      String?   @map("pay_url")
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  paidAt      DateTime? @map("paid_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([status])
  @@map("invoices")
}

// People who run the platform itself (not an agency): the console at /console
model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

// Everything done from the console, and platform-level events (sign-ups, payments, suspensions)
model PlatformEvent {
  id        Int      @id @default(autoincrement())
  actor     String // "console: email", "system", "agency: slug"
  action    String
  agencyId  Int?     @map("agency_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agencyId])
  @@index([createdAt])
  @@map("platform_events")
}
