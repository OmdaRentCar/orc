generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         String     @default("staff") // owner | staff
  createdAt    DateTime   @default(now()) @map("created_at")
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model Car {
  id           Int       @id @default(autoincrement())
  brand        String
  model        String
  type         String
  year         Int
  price        Float
  image        String?
  images       String[]  @default([]) // extra gallery photos, shown on the car page
  available    Boolean   @default(true)
  seats        Int       @default(5)
  fuel         String    @default("Petrol")
  transmission String    @default("Auto")
  description  String?
  features     String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  bookings     Booking[]

  @@index([brand])
  @@index([type])
  @@map("cars")
}

model Booking {
  id              Int            @id @default(autoincrement())
  reference       String         @unique // shown to the customer, used on the status page
  carId           Int            @map("car_id")
  guestName       String         @map("guest_name")
  phone           String
  email           String?
  startDate       String         @map("start_date")
  endDate         String         @map("end_date")
  pickupTime      String         @default("10:00") @map("pickup_time")
  returnTime      String         @default("10:00") @map("return_time")
  deliveryType    String         @default("agency") @map("delivery_type") // agency | delivery
  deliveryAddress String?        @map("delivery_address")
  // pending -> approved -> picked_up -> completed; or declined / cancelled
  status          String         @default("pending")
  documentImage   String?        @map("document_image")
  extras          Json           @default("[]")
  subtotal        Float          @default(0)
  discount        Float          @default(0)
  extrasTotal     Float          @default(0) @map("extras_total")
  deliveryFee     Float          @default(0) @map("delivery_fee")
  total           Float
  deposit         Float          @default(0)
  paymentStatus   String         @default("unpaid") @map("payment_status") // unpaid | deposit | paid
  amountPaid      Float          @default(0) @map("amount_paid")
  locale          String         @default("en") // language used for customer emails
  source          String         @default("online") // online | admin
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  car             Car            @relation(fields: [carId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([carId, status, startDate, endDate])
  @@index([createdAt])
  @@index([phone])
  @@map("bookings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  bookingId Int?     @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([read])
  @@map("notifications")
}

// Single row (id = 1) holding pricing and business options editable from the admin Settings page
model BusinessSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model BlockedCustomer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // digits only, see normalizePhone()
  name      String?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_customers")
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  adminId   Int?       @map("admin_id")
  username  String
  action    String
  entity    String
  entityId  Int?       @map("entity_id")
  details   String?
  createdAt DateTime   @default(now()) @map("created_at")
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}
