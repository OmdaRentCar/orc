# ─── Database ─────────────────────────────────────────────────────────────────
# Production: a Neon connection string. Local: any PostgreSQL, e.g.
# postgresql://youruser@localhost/rentcar?host=/var/run/postgresql
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Email (OVH SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST="ssl0.ovh.net"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="contact@example.com"
SMTP_PASS="your-smtp-password"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT="4000"
CLIENT_URL="http://localhost:5173"   # In production: https://example.com (also used for links in emails)
BUSINESS_TZ="Africa/Tunis"           # Timezone used for "today" (past-date checks, dashboard)
BRAND_NAME="RentCar"                 # Name shown in customer emails

# ─── Optional: spam protection (Cloudflare Turnstile) ─────────────────────────
# Leave empty to disable. Get keys at https://dash.cloudflare.com -> Turnstile.
# The matching site key goes in VITE_TURNSTILE_SITE_KEY below.
TURNSTILE_SECRET_KEY=""

# ─── Optional: error alerts (Sentry) ──────────────────────────────────────────
# Leave empty to disable. Create a Node.js project at https://sentry.io.
SENTRY_DSN=""

# ─── Seed admin credentials (only used during npm run seed) ───────────────────
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-in-production"
SEED_ADMIN_EMAIL="contact@example.com"

# ─── Client (Vite env vars — prefix with VITE_) ───────────────────────────────
# --- Multi-agency platform (subscriptions) ---
# Agencies live at {slug}.PLATFORM_DOMAIN; the platform site (sign-up, marketplace, console) at PLATFORM_URL
PLATFORM_DOMAIN=rentcar.tn
PLATFORM_URL=https://rentcar.tn
AGENCY_URL_TEMPLATE=https://{slug}.rentcar.tn
# Public address of this API, used by payment gateways to notify payments
API_PUBLIC_URL=https://api.rentcar.tn
# Agency answering on addresses that name none (plain localhost, the old single-agency domain); empty to disable
DEFAULT_AGENCY_SLUG=rentcar
# Company invoicing the subscriptions
PLATFORM_NAME=RentCar
PLATFORM_COMPANY=
PLATFORM_ADDRESS=
PLATFORM_TAX_ID=
PLATFORM_EMAIL=
PLATFORM_VAT_PCT=19
# First console account, created at start-up if missing (http(s)://PLATFORM_URL/console)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Plans: prices in DT/month (a year = 10 months), trial length, days of grace before suspension
PLAN_PRICES=starter:49,pro:129,business:249
TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
# Payments: konnect | flouci (empty = test mode, refused in production)
PAYMENTS_PROVIDER=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Sandbox: https://api.sandbox.konnect.network/api/v2
KONNECT_API_URL=
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
# Emails: smtp (above) | brevo | resend. EMAIL_FROM = sending address (verified with the provider)
EMAIL_PROVIDER=smtp
EMAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
# Agencies' own domains: where their CNAME points (and the IP for bare domains); Render registration
CUSTOM_DOMAIN_TARGET=cname.rentcar.tn
CUSTOM_DOMAIN_IP=
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Set these in Vercel dashboard for production
VITE_API_BASE_URL=""     # In production: https://api.example.com
VITE_TURNSTILE_SITE_KEY=""   # Optional, pairs with TURNSTILE_SECRET_KEY
VITE_SENTRY_DSN=""           # Optional, a Sentry React project's DSN
# Platform site address for the client (agencies are {slug}.<this>)
VITE_PLATFORM_DOMAIN=rentcar.tn
